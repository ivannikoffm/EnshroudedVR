#version 450
// EnshroudedVR v1.1.1 post pass: game frame (R8G8B8A8_UNORM, sRGB-encoded bytes) -> CAS sharpen + contrast/saturation/gamma
// -> intermediate UNORM image -> bitwise copy into the SRGB XR swapchain (gamma path unchanged).
// CAS = AMD FidelityFX Contrast Adaptive Sharpening (no-scaling path), applied on the encoded values like ReShade CAS.
// Neutral parameters (sharp 0, contrast 1, sat 1, gamma 1) reproduce the input bit-exactly (offline test_post).
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, rgba8) uniform readonly image2D src;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D dst;
layout(push_constant) uniform P { float sharp; float contrast; float sat; float gamma; ivec2 size; } p;

vec3 L(ivec2 c) { return imageLoad(src, clamp(c, ivec2(0), p.size - 1)).rgb; }

void main() {
    ivec2 xy = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(xy, p.size))) return;
    vec3 e = L(xy);
    vec3 o = e;
    if (p.sharp > 0.0) {
        vec3 a = L(xy + ivec2(-1, -1)), b = L(xy + ivec2(0, -1)), c = L(xy + ivec2(1, -1));
        vec3 d = L(xy + ivec2(-1, 0)),                             f = L(xy + ivec2(1, 0));
        vec3 g = L(xy + ivec2(-1, 1)), h = L(xy + ivec2(0, 1)),  i = L(xy + ivec2(1, 1));
        vec3 mn = min(min(min(d, e), min(f, b)), h);
        vec3 mx = max(max(max(d, e), max(f, b)), h);
        mn += min(mn, min(min(a, c), min(g, i)));          // soft min/max over cross + full 3x3 (range 0..2)
        mx += max(mx, max(max(a, c), max(g, i)));
        vec3 amp = sqrt(clamp(min(mn, 2.0 - mx) / max(mx, vec3(1e-5)), 0.0, 1.0));
        float peak = -1.0 / mix(8.0, 5.0, clamp(p.sharp, 0.0, 1.0));
        vec3 w = amp * peak;
        o = clamp(((b + d + f + h) * w + e) / (1.0 + 4.0 * w), 0.0, 1.0);
    }
    if (p.contrast != 1.0) o = (o - 0.5) * p.contrast + 0.5;
    if (p.sat != 1.0) { float l = dot(o, vec3(0.2126, 0.7152, 0.0722)); o = mix(vec3(l), o, p.sat); }
    o = clamp(o, 0.0, 1.0);
    if (p.gamma != 1.0) o = pow(o, vec3(p.gamma));
    imageStore(dst, xy, vec4(o, 1.0));
}
