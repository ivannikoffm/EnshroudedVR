#version 450
// EnshroudedVR S12: motion vectors for PER-EYE DLSS history (alternate-eye rendering).
// The game writes MV = where the pixel was in the PREVIOUS frame (= the other eye). With one DLSS history per eye the
// history to sample is the SAME eye two frames ago, so for the static part:  MV' = MV + (uv_prevSame - uv_prevOther).
// Cameras (row-vector, v = X*R + t, read from the render camera struct r14+0x1f10 at each DLSS evaluate) are given
// relative to the CURRENT camera: v_k = X_rel*R_k + d_k, X_rel = world - p_cur (no large world floats on the GPU).
// The conventions (depth encoding, NDC y direction, MV sign per axis, MV unit) are not documented: mode 1 (calibration)
// predicts the game's own MV (cur -> prevOther) for 48 combinations at 32x32 sample points and writes |error| per
// combination; the CPU picks the combination that matches static pixels (median < 1.5 px) and mode 0 applies it.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D depthTex;
layout(set = 0, binding = 1) uniform sampler2D mvTex;
layout(set = 0, binding = 2, rg16f) uniform writeonly image2D mvOut;
layout(std430, set = 0, binding = 3) readonly buffer Cam {
    vec4 R[3][3];      // R[k][row] (xyz), k: 0 = current, 1 = prev (other eye), 2 = prev-prev (same eye)
    vec4 d[3];         // d[k].xyz = (p_cur - p_k) * R_k ; d[0] = 0
    vec4 proj;         // P00, P11, near, unused
    ivec4 info;        // w, h, convention (bits: depth 0..2 | yflip <<2 | sx <<3 | sy <<4 | ndcUnit <<5), unused
} cam;
layout(std430, set = 0, binding = 4) writeonly buffer Calib { float err[]; } cal;   // [sample][48], px
layout(push_constant) uniform P { int mode; int grid; } pc;

float viewZ(float dep, int dt) {
    float n = cam.proj.z;
    if (dt == 0) return n / max(1.0 - dep, 1e-7);   // forward infinite: d = 1 - n/z
    if (dt == 1) return n / max(dep, 1e-9);         // reverse infinite: d = n/z
    return dep;                                     // linear view depth
}
vec2 toNdc(vec2 uv, bool yflip) { return vec2(uv.x * 2.0 - 1.0, yflip ? 1.0 - 2.0 * uv.y : 2.0 * uv.y - 1.0); }
vec2 toUv(vec2 ndc, bool yflip) { return vec2(ndc.x * 0.5 + 0.5, yflip ? 0.5 - 0.5 * ndc.y : 0.5 + 0.5 * ndc.y); }
vec3 rowmul(vec3 x, int k) { return x.x * cam.R[k][0].xyz + x.y * cam.R[k][1].xyz + x.z * cam.R[k][2].xyz; }
// X_rel (world relative to current camera) from a current-frame pixel
vec3 worldRel(vec2 uv, float dep, int dt, bool yflip) {
    float z = min(viewZ(dep, dt), 1e5);
    vec2 n = toNdc(uv, yflip);
    vec3 v = vec3(n.x / cam.proj.x * z, n.y / cam.proj.y * z, z);
    // v = X_rel*R0  ->  X_rel = v*R0^T  (rows of R0 are orthonormal)
    return vec3(dot(v, cam.R[0][0].xyz), dot(v, cam.R[0][1].xyz), dot(v, cam.R[0][2].xyz));
}
vec2 project(vec3 xrel, int k, bool yflip) {
    vec3 v = rowmul(xrel, k) + cam.d[k].xyz;
    vec2 ndc = vec2(cam.proj.x * v.x, cam.proj.y * v.y) / max(v.z, 1e-4);
    return toUv(ndc, yflip);
}
vec2 toMv(vec2 duv, int conv) {
    float sx = (conv & 8) != 0 ? -1.0 : 1.0, sy = (conv & 16) != 0 ? -1.0 : 1.0, u = (conv & 32) != 0 ? 2.0 : 1.0;
    return vec2(sx * duv.x, sy * duv.y) * u;
}

void main() {
    ivec2 sz = cam.info.xy;
    if (pc.mode == 1) {   // calibration on a grid
        ivec2 g = ivec2(gl_GlobalInvocationID.xy);
        if (g.x >= pc.grid || g.y >= pc.grid) return;
        ivec2 px = ivec2((vec2(g) + 0.5) / float(pc.grid) * vec2(sz));
        vec2 uv = (vec2(px) + 0.5) / vec2(sz);
        float dep = texelFetch(depthTex, px, 0).r;
        vec2 mv = texelFetch(mvTex, px, 0).rg;
        int base = (g.y * pc.grid + g.x) * 48;
        for (int c = 0; c < 48; ++c) {
            int dt = c % 3, rest = c / 3;               // rest bits: yflip, sx, sy, unit
            int conv = dt | ((rest & 1) << 2) | ((rest & 2) << 2) | ((rest & 4) << 2) | ((rest & 8) << 2);
            bool yf = (conv & 4) != 0;
            vec3 x = worldRel(uv, dep, dt, yf);
            vec2 pred = toMv(project(x, 1, yf) - uv, conv);
            cal.err[base + c] = length((mv - pred) * vec2(sz));
        }
        return;
    }
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(px, sz))) return;
    int conv = cam.info.z; int dt = conv & 3; bool yf = (conv & 4) != 0;
    vec2 uv = (vec2(px) + 0.5) / vec2(sz);
    float dep = texelFetch(depthTex, px, 0).r;
    vec2 mv = texelFetch(mvTex, px, 0).rg;
    vec3 x = worldRel(uv, dep, dt, yf);
    vec2 corr = toMv(project(x, 2, yf) - project(x, 1, yf), conv);
    imageStore(mvOut, px, vec4(mv + corr, 0.0, 0.0));
}
